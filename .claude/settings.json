{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rulebook-guard.sh\"",
            "timeout": 15,
            "statusMessage": "Checking RULEBOOK non-negotiables…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-edit.sh\"",
            "timeout": 120,
            "statusMessage": "Typechecking (tsc --noEmit)…"
          }
        ]
      }
    ]
  }
}
