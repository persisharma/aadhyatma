{
  "expo": {
    "name": "Vedansh",
    "slug": "vedansh",
    "scheme": "vedansh",
    "version": "1.4.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prashantsharma.vedansh",
      "buildNumber": "37",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.prashantsharma.vedansh",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "USE_FULL_SCREEN_INTENT",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B8621B",
          "sounds": [
            "./assets/japam-alarm-sounds/om-namah-shivaya.wav"
          ]
        }
      ],
      "./plugins/withJapamAlarmNative.js",
      "./plugins/withJapamAlarmIos.js",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vedansh uses your location only to compute accurate sunrise and panchang times for your city. Location never leaves your device.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "owner": "prashant.sharma",
    "extra": {
      "eas": {
        "projectId": "c83547c2-423c-4902-9087-a9ec9879a1f9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c83547c2-423c-4902-9087-a9ec9879a1f9"
    }
  }
}
