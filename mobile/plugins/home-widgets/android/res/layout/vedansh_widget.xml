<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:gravity="center_vertical"
    android:background="@drawable/vedansh_widget_background">
    <LinearLayout android:id="@+id/widget_panchang_zone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/widget_kicker" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#8A3E0B" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#1A0E03" android:textSize="20sp" android:textStyle="bold" android:fontFamily="serif" android:maxLines="2" />
        <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#5A3A1E" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#5A3A1E" android:textSize="13sp" android:fontFamily="serif" android:maxLines="2" />
</LinearLayout>
