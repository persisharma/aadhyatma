# Vedansh — environment variables template.
# Copy to .env.local for local dev. Do not commit secrets or real values.

# Example (Expo reads EXPO_PUBLIC_* vars into the client bundle):
# EXPO_PUBLIC_API_URL=https://api.example.com

# CDN base for heavy assets served from R2 (kids-stories art, audio library).
# Public URL, not a secret — only an OVERRIDE: the app defaults to the production
# CDN in code (see assetManifest.ts), so it works in builds and OTA without this.
# For local testing put a value in .env.local.
# EXPO_PUBLIC_ASSET_BASE_URL=https://cdn.vedansh.app

# Native Meta activation tracking. Read during prebuild; never EXPO_PUBLIC_*.
# Android/iOS identifiers were verified in Meta App settings on 2026-10-07.
META_APP_ID=1128589089734962
META_TRACKING_ENABLED=false
# Obtain the SDK CLIENT token from Meta App settings > Advanced. Never the app secret.
META_CLIENT_TOKEN=
