# Vedansh — environment variables template.
# Copy to .env.local for local dev. Do not commit secrets or real values.

# Example (Expo reads EXPO_PUBLIC_* vars into the client bundle):
# EXPO_PUBLIC_API_URL=https://api.example.com

# Analytics — PostHog project key (public, write-only). When unset the
# analytics layer no-ops, so local dev / forks need no extra setup.
# EXPO_PUBLIC_POSTHOG_KEY=
# Optional — defaults to https://us.i.posthog.com. Use https://eu.i.posthog.com
# if your PostHog project is in the EU region.
# EXPO_PUBLIC_POSTHOG_HOST=
