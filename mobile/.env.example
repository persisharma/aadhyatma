# Vedansh — environment variables template.
# Copy to .env.local for local dev. Do not commit secrets or real values.

# Example (Expo reads EXPO_PUBLIC_* vars into the client bundle):
# EXPO_PUBLIC_API_URL=https://api.example.com

# CDN base for heavy assets served from R2 (kids-stories art, audio library).
# Public URL, not a secret. When unset the app falls back to its placeholder.
# Set per build profile in eas.json; for local runs put it in .env.local.
# EXPO_PUBLIC_ASSET_BASE_URL=https://cdn.vedansh.app
