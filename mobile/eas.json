{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "dev-sim": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "dev-sim"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6766086529"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/play-store-key.json",
        "track": "internal"
      }
    }
  }
}
