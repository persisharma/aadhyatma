{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "22.14.0"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "22.14.0"
    },
    "dev-sim": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "dev-sim",
      "node": "22.14.0"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "node": "22.14.0"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6766086529"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/play-store-key.json",
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
