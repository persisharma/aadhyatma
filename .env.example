# Vedansh push notification send script — copy to .env and fill in.
# .env is git-ignored. Never commit real keys.
#
# Find these values at: Supabase dashboard → Project Settings → API
#   SUPABASE_URL                = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY   = "service_role" key (NOT the anon key)
#
# The service-role key bypasses RLS so the send script can read every token.
# Keep it local — it grants full DB access.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
