# /ship pipeline state (ephemeral, per-run)
.ship-pipeline-state
.ship-1b-verdict
.ship-baseline-tests.json
.ship-4a-regression-check.json

# Per-session logs and learnings (local tooling)
.claude/ship-logs/
.claude/scheduled_tasks.lock

# Conductor workspace scratchpad
.context/

# Superpowers visual brainstorming scratchpad
.superpowers/

# Local secrets — Expo access tokens (EXPO_TOKEN) etc. NEVER commit these.
# Preferred path is an env var set in the environment config, not a file; these
# entries are a safety net for local `export`-into-a-file workflows.
.env.local
.env.*.local
mobile/.env.local
mobile/.env.*.local

# macOS
.DS_Store

# Natural Earth download cache for build-india-map.mjs
scripts/.cache/

# Marketing reel pipeline — regenerable outputs (keep the tooling, ignore the artifacts)
marketing/linkedin/shots/
marketing/linkedin/frames/
marketing/linkedin/slides/
marketing/linkedin/*.mp4
marketing/linkedin/.metro.log
